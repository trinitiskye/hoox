# ============================================================
# FishTournament Pro - Environment Variables
# ============================================================
# Copy this file to .env.local for local development
# Add these as environment variables in Cloudflare Pages dashboard
# (Settings → Environment variables)
#
# Supabase Project: Hoox
# Project ID: iefjracmxpkpwndrksps
# ============================================================

# ------ REQUIRED: Get from Supabase Dashboard ------
# Go to: https://supabase.com/dashboard/project/iefjracmxpkpwndrksps/settings/api

# Your Supabase project URL (always this format)
NEXT_PUBLIC_SUPABASE_URL=https://iefjracmxpkpwndrksps.supabase.co

# Anon/public key - safe to expose in browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key - NEVER expose publicly, only for server-side use.
# Required as of the login/admin-actions security fix: src/app/api/**
# route handlers use this (never NEXT_PUBLIC_) to verify logins and perform
# admin actions server-side, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------ REQUIRED: generate your own random value ------
# Signs the httpOnly session cookie the API routes use to recognize a
# logged-in admin. Never expose this publicly. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace_with_a_long_random_string

# ------ OPTIONAL: App Config ------
NEXT_PUBLIC_APP_NAME=FishTournament Pro
NEXT_PUBLIC_APP_FEE=6.50
NEXT_PUBLIC_ADMIN_EMAIL=admin@fishtournament.com
